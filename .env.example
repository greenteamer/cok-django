# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database settings
DB_NAME=django_db
DB_USER=django_user
DB_PASSWORD=strong_password_here
DB_HOST=db
DB_PORT=5432

# Host port mapped to the PostgreSQL container (host access only, e.g. psql/DBeaver).
# Django uses DB_HOST/DB_PORT over the Docker network and ignores this.
DB_HOST_PORT=5433

# Startup settings
DB_WAIT_TIMEOUT=30

# Media files (local filesystem fallback)
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
SERVE_MEDIA=False

# Cloudflare R2 Storage (set USE_R2=True to enable)
USE_R2=False
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=media.yourdomain.com
